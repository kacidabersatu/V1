    // ------------------------------------------
    // MODUL 3: PLAN MASTERSHIFT (BULANAN)
    // ------------------------------------------
    function MasterShiftView({ user, showToast }) {
      const isManager = ['Chief Of Store', 'Assistant Chief of Store', 'Super Admin'].includes(user.jabatan);
      const [selectedKaryawan, setSelectedKaryawan] = useState(DEFAULT_USERS[2].nama);
      const [schedule, setSchedule] = useState(() => {
        // Init 31 hari
        const days = {};
        for(let i=1; i<=31; i++) {
          days[i] = i % 7 === 0 ? 'OFF' : (i % 2 === 0 ? 'P1 (06-15)' : 'S2 (14-23)');
        }
        return days;
      });

      const handleShiftChange = (day, newShift) => {
        if (!isManager) {
          showToast('Hanya COS & ACOS yang memiliki hak edit Mastershift!', 'error');
          return;
        }
        setSchedule({ ...schedule, [day]: newShift });
        showToast(`Shift tgl ${day} diubah ke ${newShift}`);
      };

      return (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <div>
              <h3 className="font-bold text-sm">Modul 3: Plan Mastershift Karyawan (Oktober 2026)</h3>
              <p className="text-[11px] text-slate-400">Hak Akses: {isManager ? 'Bisa Mengedit (COS/ACOS)' : 'Hanya Melihat (Crew)'}</p>
            </div>
            <select value={selectedKaryawan} onChange={(e) => setSelectedKaryawan(e.target.value)} className="text-xs p-1.5 rounded border dark:bg-slate-900 font-bold">
              {DEFAULT_USERS.filter(u => u.jabatan !== 'Super Admin').map(u => (
                <option key={u.nik} value={u.nama}>{u.nama.split(' ')[0]} ({u.jabatan})</option>
              ))}
            </select>
          </div>

          <div className="grid grid-cols-4 sm:grid-cols-7 gap-2">
            {Object.keys(schedule).map(day => (
              <div key={day} className={`p-2 rounded-xl border text-center ${
                schedule[day] === 'OFF' ? 'bg-rose-50 dark:bg-rose-950/30 border-rose-200 text-rose-600' : 'bg-white dark:bg-emerald-950/40 border-emerald-100 text-slate-700 dark:text-slate-200'
              }`}>
                <div className="text-[10px] font-bold text-slate-400">Tgl {day}</div>
                {isManager ? (
                  <select 
                    value={schedule[day]} 
                    onChange={(e) => handleShiftChange(day, e.target.value)}
                    className="w-full text-[9px] font-bold mt-1 bg-transparent text-center outline-none cursor-pointer"
                  >
                    <option value="P1 (06-15)">Pagi</option>
                    <option value="S2 (14-23)">Siang</option>
                    <option value="MID (11-20)">Mid</option>
                    <option value="OFF">OFF</option>
                    <option value="CUTI">Cuti</option>
                  </select>
                ) : (
                  <div className="text-[10px] font-bold mt-1">{schedule[day]}</div>
                )}
              </div>
            ))}
          </div>
        </div>
      );
    }

