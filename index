                <option value="02">Station 02</option>
                <option value="03">Station 03</option>
              </select>
            </div>
            <div>
              <label className="text-[10px] font-bold text-slate-500">Nomor Bon (Maks. 4 Digit)</label>
              <input 
                type="text" 
                maxLength="4" 
                placeholder="Misal: 42" 
                value={inputBon} 
                onChange={(e) => setInputBon(e.target.value.replace(/[^0-9]/g, ''))} 
                className="w-full text-xs p-2 rounded border dark:bg-slate-900 font-mono text-center font-bold" 
              />
            </div>
          </div>

          <div className="p-4 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-center space-y-2">
            <div className="text-[10px] uppercase font-bold text-slate-400">Format Lengkap Transaksi Struk</div>
