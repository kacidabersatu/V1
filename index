              className="w-full text-xs p-2.5 pl-8 rounded-xl border border-emerald-200 dark:border-emerald-800 dark:bg-slate-900 outline-none"
            />
            <Icon name="search" className="w-4 h-4 text-slate-400 absolute left-2.5 top-3" />
          </div>

          <div className="space-y-3">
            {filteredFaqs.map((faq, i) => (
              <div key={i} className="p-3.5 rounded-xl border border-emerald-100 dark:border-emerald-800/60 bg-white dark:bg-emerald-950/20 text-xs space-y-1">
                <div className="font-bold text-slate-800 dark:text-emerald-200 flex items-center gap-1.5">
                  <span className="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
                  {faq.q}
                </div>
                <p className="text-slate-600 dark:text-slate-300 leading-relaxed pl-3">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      );
    }

    // ------------------------------------------
    // DASHBOARD AUDIT SUPER ADMIN (NIK 14125034)
    // ------------------------------------------
    function ModuleAdminAudit({ showToast }) {
      const handlePurge = () => {
        if (confirm('Yakin ingin mereset seluruh cache database lokal kembali ke bawaan demo?')) {
          localStorage.clear();
          showToast('Database lokal berhasil dibersihkan.');
          setTimeout(() => location.reload(), 800);
        }
      };

      return (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <h3 className="font-bold text-base font-display text-amber-700 dark:text-amber-300">👑 Super Admin Audit & Database Config</h3>
            <span className="text-[10px] px-2 py-0.5 rounded bg-amber-500 text-white font-mono font-bold">NIK 14125034</span>
          </div>

          <div className="p-3 rounded-xl border border-amber-300 bg-amber-50/50 dark:bg-amber-950/20 text-xs">
            Super Admin memiliki kewenangan memantau seluruh log mutasi data, konektivitas Google Apps Script, konfigurasi lembar spreadsheet, dan pemulihan darurat.
          </div>

          <div className="space-y-2">
            <h4 className="text-xs font-bold text-slate-500 uppercase">Tindakan Administrator</h4>
            <div className="grid grid-cols-2 gap-2">
              <button onClick={() => showToast('Log Audit 2026 berhasil diarsipkan.')} className="p-2.5 rounded-lg border text-left text-xs font-bold bg-white dark:bg-slate-900">
                📥 Unduh Log Akses User
              </button>
              <button onClick={handlePurge} className="p-2.5 rounded-lg border border-rose-300 text-left text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-600">
                ⚠️ Reset Cache Lokal
              </button>
            </div>
          </div>
        </div>
      );
    }

    // ==========================================
    // 7. CHAT AI ASISTEN OPERASIONAL RETAIL
    // ==========================================
    function ChatAiOps({ user }) {
      const [messages, setMessages] = useState([
        { sender: 'ai', text: `Halo ${user.nama.split(' ')[0]}! Saya Kacida Assistant. Ada yang bisa saya bantu seputar SOP Alfamart, perhitungan IKT, tips penawaran kasir, atau penanganan retur barang hari ini?` }
      ]);
      const [input, setInput] = useState('');

      const handleSend = (e) => {
        e.preventDefault();
        if (!input.trim()) return;

        const userMsg = input;
        setMessages(prev => [...prev, { sender: 'user', text: userMsg }]);
        setInput('');

        // Smart Response Generator
        setTimeout(() => {
          let reply = 'Terima kasih atas laporannya. Terus tingkatkan penawaran PSM di kasir serta perhatikan kebersihan display chiller ya!';
          const lower = userMsg.toLowerCase();
          if (lower.includes('psm')) {
            reply = 'Tips penawaran PSM kasir: Selalu ucapkan senyum-sapa-salam, tawarkan 2 produk komplementer (contoh: roti dengan susu) dan sebutkan nominal hemat promo!';
          } else if (lower.includes('ikt') || lower.includes('margin')) {
            reply = 'Rumus GM Rupiah IKT = Net Sales x Gross Margin %. Jaga rasio NSB < 0.15% dan hindari stok OOS pada top 200 item sales.';
          } else if (lower.includes('exp') || lower.includes('kadaluarsa')) {
            reply = 'SOP EXP Toko: Tarik produk &le;60 hari ke kardus retur BKL/DC atau segera tempel stiker diskon percepatan sales.';
          }
          setMessages(prev => [...prev, { sender: 'ai', text: reply }]);
        }, 600);
      };

      return (
        <div className="flex flex-col h-[75vh] border rounded-2xl bg-white dark:bg-emerald-950/30 overflow-hidden shadow-sm">
          <div className="p-3 bg-brand-600 text-white flex items-center justify-between text-xs font-bold">
            <span className="flex items-center gap-1.5"><Icon name="bot" className="w-4 h-4" /> AI Asisten Operasional Retail</span>
            <span className="text-[10px] bg-brand-800 px-2 py-0.5 rounded-full">Online Simulator</span>
          </div>

          <div className="flex-1 overflow-y-auto p-4 space-y-3">
            {messages.map((m, idx) => (
              <div key={idx} className={`flex ${m.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                <div className={`max-w-[80%] p-3 rounded-2xl text-xs leading-relaxed ${
                  m.sender === 'user' 
                    ? 'bg-brand-600 text-white rounded-br-none' 
                    : 'bg-emerald-50 dark:bg-emerald-900/40 text-slate-800 dark:text-emerald-100 rounded-bl-none border border-emerald-100 dark:border-emerald-800'
                }`}>
                  {m.text}
                </div>
              </div>
            ))}
          </div>

          <form onSubmit={handleSend} className="p-2 border-t flex gap-2 bg-slate-50 dark:bg-emerald-950/60">
            <input 
              type="text" 
              placeholder="Tanyakan SOP, rumus IKT, atau trik kasir..." 
              value={input} 
              onChange={(e) => setInput(e.target.value)} 
              className="flex-1 text-xs p-2 rounded-xl border dark:bg-slate-900 outline-none" 
            />
            <button type="submit" className="px-4 py-2 bg-brand-600 text-white font-bold text-xs rounded-xl">Kirim</button>
          </form>
        </div>
      );
    }

    // ==========================================
    // 8. PROFIL VIEW & USER ROLE SWITCHER
    // ==========================================
    function ProfileView({ user, onSelectUser }) {
      return (
        <div className="space-y-4">
          <div className="p-5 rounded-2xl border bg-white dark:bg-emerald-950/40 flex items-center gap-4 shadow-sm">
            <img src={user.foto} alt={user.nama} className="w-16 h-16 rounded-2xl object-cover border-2 border-brand-500 shadow-md" />
            <div>
              <span className="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-brand-100 dark:bg-brand-900 text-brand-700 dark:text-brand-300">
                {user.jabatan}
              </span>
              <h2 className="text-base font-bold font-display mt-1">{user.nama}</h2>
              <p className="text-xs text-slate-400 font-mono">NIK: {user.nik}</p>
              <p className="text-xs text-emerald-600 font-medium">{user.namaToko}</p>
            </div>
          </div>

          <div className="p-4 rounded-2xl border bg-white dark:bg-emerald-950/40 space-y-3">
            <h4 className="text-xs font-bold text-slate-500 uppercase tracking-wider">Beralih Akun Uji Coba Demo</h4>
            <div className="space-y-2">
              {DEFAULT_USERS.map(u => (
                <div 
                  key={u.nik}
                  onClick={() => onSelectUser(u.nik)}
                  className={`p-3 rounded-xl border cursor-pointer flex justify-between items-center transition-all ${
                    u.nik === user.nik ? 'border-brand-500 bg-brand-50/50 dark:bg-emerald-900/30' : 'hover:bg-slate-50 dark:hover:bg-slate-900'
                  }`}
                >
                  <div className="flex items-center gap-2.5">
                    <img src={u.foto} className="w-8 h-8 rounded-lg object-cover" />
                    <div>
                      <div className="text-xs font-bold">{u.nama}</div>
                      <div className="text-[10px] text-slate-400">{u.jabatan} | {u.namaToko}</div>
                    </div>
                  </div>
                  {u.nik === user.nik && <Icon name="check" className="w-4 h-4 text-brand-600 font-bold" />}
                </div>
              ))}
            </div>
          </div>
        </div>
      );
    }

    // Render ke DOM
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
