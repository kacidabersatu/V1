    // ------------------------------------------
    function ModuleKonversiBon({ showToast }) {
      const [inputBon, setInputBon] = useState('');
      const [posStation, setPosStation] = useState('01');

      // Formula Standar Transaksi Alfamart: POS-YYMMDD-XXXX
      const hasilKonversi = useMemo(() => {
        if (!inputBon) return '-';
        const padded = inputBon.padStart(4, '0');
        const now = new Date();
        const codeDate = `${now.getFullYear().toString().slice(-2)}${(now.getMonth()+1).toString().padStart(2, '0')}${now.getDate().toString().padStart(2, '0')}`;
        return `TRX-${posStation}-${codeDate}-${padded}`;
      }, [inputBon, posStation]);

      const copyToClipboard = () => {
        navigator.clipboard.writeText(hasilKonversi);
        showToast('Nomor struk lengkap disalin!');
      };

      return (
        <div className="space-y-4">
          <h3 className="font-bold text-sm">Modul 9: Konversi No Bon / Struk Kasir</h3>
          <p className="text-[11px] text-slate-400">Masukkan 1 s/d 4 digit nomor urut transaksi kasir untuk menghasilkan barcode struk penuh.</p>

          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="text-[10px] font-bold text-slate-500">Nomor Station / Kasir POS</label>
              <select value={posStation} onChange={(e) => setPosStation(e.target.value)} className="w-full text-xs p-2 rounded border dark:bg-slate-900">
