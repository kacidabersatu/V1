    // ------------------------------------------
    // MODUL 1: CEKLIS EXP
    // ------------------------------------------
    function ModuleEXP({ user, showToast, exportCSV, expState }) {
      const [expList, setExpList] = expState;
      const [tab, setTab] = useState('input'); // input, alert, riwayat
      const [form, setForm] = useState({ kodeItem: '', namaBarang: '', rak: '01', tglExp: '', qty: 1 });

      const handleAdd = (e) => {
        e.preventDefault();
        if (!form.namaBarang || !form.tglExp) {
          showToast('Isi nama barang dan tanggal kadaluarsa!', 'error');
          return;
        }
        const item = { ...form, id: Date.now(), user: user.nama, tglInput: new Date().toLocaleDateString('id-ID') };
        const updated = [item, ...expList];
        setExpList(updated);
        localStorage.setItem('kb_exp', JSON.stringify(updated));
        showToast('Data EXP berhasil dicatat!');
        setForm({ kodeItem: '', namaBarang: '', rak: '01', tglExp: '', qty: 1 });
      };

      const getDaysDiff = (targetDate) => {
        const diffTime = new Date(targetDate) - new Date();
        return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      };

      const alertExpList = expList.filter(item => getDaysDiff(item.tglExp) <= 60);

      return (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <h3 className="font-bold text-sm">Modul 1: Ceklis & Monitoring EXP Barang</h3>
            <button onClick={() => exportCSV(expList, 'DATA_EXP_RAK')} className="text-xs font-semibold px-2.5 py-1 rounded bg-brand-100 dark:bg-brand-900 text-brand-700 dark:text-brand-300">
              Export CSV
            </button>
          </div>

          <div className="flex border-b border-emerald-200 dark:border-emerald-800 text-xs font-bold gap-4">
            <button onClick={() => setTab('input')} className={`pb-2 ${tab === 'input' ? 'border-b-2 border-brand-500 text-brand-600' : 'text-slate-400'}`}>Input Barang</button>
            <button onClick={() => setTab('alert')} className={`pb-2 ${tab === 'alert' ? 'border-b-2 border-brand-500 text-brand-600' : 'text-slate-400'}`}>Alert EXP (&le;60 Hari) ({alertExpList.length})</button>
            <button onClick={() => setTab('riwayat')} className={`pb-2 ${tab === 'riwayat' ? 'border-b-2 border-brand-500 text-brand-600' : 'text-slate-400'}`}>Riwayat Input ({expList.length})</button>
          </div>

          {tab === 'input' && (
            <form onSubmit={handleAdd} className="space-y-3 bg-slate-50 dark:bg-emerald-950/40 p-4 rounded-xl border border-emerald-100 dark:border-emerald-900">
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="text-[10px] font-bold text-slate-500">Rak / Area</label>
                  <select value={form.rak} onChange={(e) => setForm({...form, rak: e.target.value})} className="w-full text-xs p-2 rounded border dark:bg-slate-900">
                    <option value="01">Rak 01 - Snack</option>
                    <option value="02">Rak 02 - Minuman</option>
                    <option value="03">Rak 03 - Milk & Baby</option>
                    <option value="04">Rak 04 - Biskuit</option>
                    <option value="Chiller">Chiller Fresh</option>
                  </select>
                </div>
                <div>
