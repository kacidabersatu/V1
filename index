    // ------------------------------------------
    // MODUL 5: SIMULASI GM RP IKT
    // ------------------------------------------
    function ModuleSimulasiIKT({ showToast }) {
      const [netSales, setNetSales] = useState(350000000);
      const [gmPercent, setGmPercent] = useState(19.5);
      const [targetGmRp, setTargetGmRp] = useState(65000000);

      const realisasiGmRp = useMemo(() => {
        return Math.round(netSales * (gmPercent / 100));
      }, [netSales, gmPercent]);

      const acvGmRp = useMemo(() => {
        return targetGmRp ? ((realisasiGmRp / targetGmRp) * 100).toFixed(2) : 0;
      }, [realisasiGmRp, targetGmRp]);

      const handleReset = () => {
        setNetSales(350000000);
        setGmPercent(19.5);
        setTargetGmRp(65000000);
        showToast('Kalkulator Simulasi direset ke nilai standar!');
      };

      return (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <h3 className="font-bold text-sm">Modul 5: Kalkulator Simulasi GM Rupiah IKT</h3>
            <button onClick={handleReset} className="text-xs font-bold text-rose-600 dark:text-rose-400">Reset</button>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div className="space-y-1">
              <label className="text-[10px] font-bold text-slate-500">Estimasi Net Sales (Rp)</label>
              <input type="number" step="1000000" value={netSales} onChange={(e) => setNetSales(Number(e.target.value))} className="w-full text-xs p-2 rounded border dark:bg-slate-900" />
            </div>
            <div className="space-y-1">
              <label className="text-[10px] font-bold text-slate-500">Gross Margin (%)</label>
              <input type="number" step="0.1" value={gmPercent} onChange={(e) => setGmPercent(Number(e.target.value))} className="w-full text-xs p-2 rounded border dark:bg-slate-900" />
            </div>
            <div className="space-y-1">
              <label className="text-[10px] font-bold text-slate-500">Target GM Rupiah (Rp)</label>
              <input type="number" step="1000000" value={targetGmRp} onChange={(e) => setTargetGmRp(Number(e.target.value))} className="w-full text-xs p-2 rounded border dark:bg-slate-900" />
            </div>
          </div>

          {/* Hasil Kalkulasi Otomatis */}
          <div className="p-4 rounded-2xl bg-gradient-to-tr from-brand-800 to-emerald-900 text-white space-y-3">
            <div className="text-[10px] uppercase font-bold text-emerald-200">Proyeksi Pencapaian GM RP Toko</div>
            <div className="flex justify-between items-end">
              <div>
                <div className="text-2xl font-black font-display">{formatRp(realisasiGmRp)}</div>
                <div className="text-xs text-emerald-200 mt-0.5">Selisih vs Target: <span className={realisasiGmRp >= targetGmRp ? 'text-mint font-bold' : 'text-rose-300 font-bold'}>{formatRp(realisasiGmRp - targetGmRp)}</span></div>
              </div>
              <div className="text-right">
                <div className="text-3xl font-black text-mint">{acvGmRp}%</div>
                <div className="text-[10px] uppercase tracking-wider text-emerald-200">ACV GM RP</div>
              </div>
            </div>
          </div>
        </div>
      );
    }

    // ------------------------------------------
    // MODUL 6: SALES MTD (2025 VS 2026)
    // ------------------------------------------
    function ModuleSalesMTD({ exportCSV }) {
      const mockMtd = [
        { tgl: '01/10', sales25: 11623882, sales26: 14067249, std25: 178, std26: 242 },
        { tgl: '02/10', sales25: 9715987, sales26: 11355377, std25: 165, std26: 141 },
        { tgl: '03/10', sales25: 10037552, sales26: 12338387, std25: 183, std26: 161 },
        { tgl: '04/10', sales25: 10928073, sales26: 12359306, std25: 198, std26: 209 },
        { tgl: '05/10', sales25: 11319864, sales26: 10434926, std25: 181, std26: 166 },
        { tgl: '06/10', sales25: 5984787, sales26: 9046129, std25: 142, std26: 159 }
      ];

      const total25 = mockMtd.reduce((acc, c) => acc + c.sales25, 0);
      const total26 = mockMtd.reduce((acc, c) => acc + c.sales26, 0);
      const growthNominal = total26 - total25;
      const growthPercent = ((growthNominal / total25) * 100).toFixed(2);

      return (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <div>
              <h3 className="font-bold text-sm">Modul 6: Sales MTD Komparasi (2025 vs 2026)</h3>
              <p className="text-[11px] text-slate-400">Analisis Pertumbuhan (Growth/Disgrowth)</p>
            </div>
            <button onClick={() => exportCSV(mockMtd, 'SALES_MTD_KOMPARASI')} className="text-xs font-semibold px-2 py-1 rounded bg-brand-100 dark:bg-brand-900 text-brand-700">Export CSV</button>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div className="p-3 rounded-xl border bg-white dark:bg-slate-900">
              <div className="text-[10px] font-bold text-slate-400">Sales MTD 2025</div>
              <div className="text-base font-extrabold">{formatRp(total25)}</div>
            </div>
            <div className="p-3 rounded-xl border bg-brand-50/50 dark:bg-emerald-950/40 border-brand-200">
              <div className="text-[10px] font-bold text-brand-700 dark:text-brand-300">Sales MTD 2026</div>
              <div className="text-base font-extrabold text-brand-700 dark:text-brand-300">{formatRp(total26)}</div>
              <div className="text-[10px] font-bold text-emerald-600 mt-0.5">Growth: +{growthPercent}% ({formatRp(growthNominal)})</div>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-left text-[11px]">
              <thead className="bg-emerald-50 dark:bg-emerald-950 font-bold">
                <tr>
                  <th className="p-2">Tanggal</th>
                  <th className="p-2">Sales 2025</th>
                  <th className="p-2">Sales 2026</th>
                  <th className="p-2">Growth (Rp)</th>
                  <th className="p-2">Growth (%)</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-emerald-100 dark:divide-emerald-900">
                {mockMtd.map((r, i) => {
                  const diff = r.sales26 - r.sales25;
                  const pct = ((diff / r.sales25) * 100).toFixed(1);
                  return (
                    <tr key={i}>
